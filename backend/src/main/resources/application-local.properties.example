# Copie este arquivo para 'application-local.properties' e preencha com suas credenciais locais

# -------------------------------------------------------------
# CREDENCIAIS DO POSTGRESQL LOCAL
# -------------------------------------------------------------
spring.datasource.url=jdbc:postgresql://localhost:5432/nome_do_banco
spring.datasource.username=postgres
spring.datasource.password=sua_senha
spring.datasource.driver-class-name=org.postgresql.Driver

# -------------------------------------------------------------
# CONFIGURAÇÕES DO JWT
# -------------------------------------------------------------
api.security.token.secret=MinhaChaveSecretaSuperSeguraParaAssinarOTokenJWT123456
# Exemplo: 86400000ms = 24h
api.security.token.expiration=86400000
